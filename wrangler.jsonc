{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcporch",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ]
  // Phase 2: Add CF_ACCESS_AUD secret
  // Phase 2: Add SYBIL_CACHE, AGREEMENTS KV bindings
  // Phase 3: Add IDENTITY_MAP KV, HATS_SUBGRAPH_URL secret
}
